# Copy to .env and fill in. Never commit .env.
# --- LLM ---
GEMINI_API_KEY=
# Optional: override the default model chain (comma-separated fallbacks)
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# --- Market data (fallback when Yahoo fails) ---
FINNHUB_API_KEY=

# --- SEC EDGAR (required, or SEC returns 403): "Name email@example.com" ---
SEC_USER_AGENT=

# --- Telegram (Phase 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API access code (Phase 3) ---
APP_ACCESS_CODE=

# --- Backends: local (SQLite / FAISS files) or dynamodb / s3 on AWS ---
STORE_BACKEND=local
VECTOR_BACKEND=local

AWS_REGION=ap-south-1
LOG_LEVEL=INFO
