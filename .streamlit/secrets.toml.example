# Copy to .streamlit/secrets.toml (git-ignored) to run the UI locally from the repo root:
#     streamlit run ui/app.py
# On Streamlit Community Cloud, paste the same two lines into the app's Settings -> Secrets.
API_URL = "https://REPLACE.execute-api.ap-southeast-2.amazonaws.com"   # stack output ApiUrl
ACCESS_CODE = ""                                                       # APP_ACCESS_CODE from .env
