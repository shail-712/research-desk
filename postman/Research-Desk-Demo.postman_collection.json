{
  "info": {
    "name": "Research Desk API - Demo",
    "description": "One-run demo of every deployed feature (docs/example_demo.md). Uses the same Postman environment as Research-Desk.postman_collection.json: base_url (the stack's ApiUrl output) and access_code (APP_ACCESS_CODE, type secret). Run it top to bottom with the Collection Runner or newman: each Ask saves its job_id and jumps to 'Poll job', which polls every 3 s until the job is done, checks that step's trace fields, then jumps to the next Ask. About 22 Gemini calls in total.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "A1 Health (no access code)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"ok is true\", () => pm.expect(pm.response.json()).to.eql({ok: true}));",
              "pm.collectionVariables.set(\"gemini_calls\", 0);"
            ]
          }
        }
      ]
    },
