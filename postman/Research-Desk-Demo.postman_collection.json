    {
      "name": "Q1 Quick: market only",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-access-code",
            "value": "{{access_code}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/ask",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ask"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is AMD's stock price?\",\n  \"mode\": \"quick\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
              "const job = pm.response.json();",
              "pm.test(\"returns a job id, status pending and a poll path\", () => {",
              "  pm.expect(job.job_id).to.match(/^[0-9a-f]{32}$/);",
              "  pm.expect(job.status).to.eql(\"pending\");",
              "  pm.expect(job.poll).to.eql(\"/ask/\" + job.job_id);",
              "});",
              "pm.collectionVariables.set(\"job_id\", job.job_id);",
              "pm.collectionVariables.set(\"expect\", \"quick-market\");",
              "pm.collectionVariables.set(\"after_poll\", \"Q2 Quick: news only\");",
              "pm.collectionVariables.set(\"polls\", 0);",
              "pm.collectionVariables.set(\"request_id\", pm.response.headers.get(\"x-request-id\"));",
              "console.log(\"Q1 Quick: market only\", \"job_id\", job.job_id, \"x-request-id\", pm.response.headers.get(\"x-request-id\"));",
              "postman.setNextRequest(\"Poll job\");"
            ]
          }
        }
      ]
    },
