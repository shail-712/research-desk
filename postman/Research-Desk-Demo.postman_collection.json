    {
      "key": "job_id",
      "value": ""
    },
    {
      "key": "expect",
      "value": ""
    },
    {
      "key": "after_poll",
      "value": ""
    },
    {
      "key": "polls",
      "value": "0"
    },
    {
      "key": "request_id",
      "value": ""
    },
    {
      "key": "gemini_calls",
      "value": "0"
    }
  ]
