    {
      "name": "Poll job",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-access-code",
            "value": "{{access_code}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/ask/{{job_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ask",
            "{{job_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const polls = Number(pm.collectionVariables.get(\"polls\") || 0);",
              "if (body.status === \"pending\" && polls < 60) {",
              "  pm.collectionVariables.set(\"polls\", polls + 1);",
              "  setTimeout(() => {}, 3000);",
              "  postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.collectionVariables.set(\"polls\", 0);",
              "  const expect = pm.collectionVariables.get(\"expect\") || \"\";",
              "  const t = body.trace || {};",
              "  const timings = body.timings || {};",
              "  const tools = (r) => (r.steps || []).filter(s => s.action === \"tool\").map(s => s.tool);",
              "",
              "  pm.test(\"job is done (not error)\", () => pm.expect(body.status, body.error).to.eql(\"done\"));",
              "  pm.test(\"answer and sources\", () => {",
              "    pm.expect(body.answer).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.sources).to.be.an(\"array\").that.is.not.empty;",
              "  });",
              "  pm.test(\"no context unless include_context\", () => pm.expect(body).to.not.have.property(\"context\"));",
              "  pm.test(\"mode is \" + (expect.startsWith(\"deep\") ? \"deep (no fallback)\" : \"quick\"), () =>",
              "    pm.expect(body.mode, body.notice).to.eql(expect.startsWith(\"deep\") ? \"deep\" : \"quick\"));",
              "",
              "  const checks = {",
              "    \"quick-market\": () => {",
              "      pm.test(\"only the market tool ran\", () => pm.expect(body.used_tools).to.eql([\"market\"]));",
              "      pm.test(\"timing for market:AMD\", () => pm.expect(timings).to.have.property(\"market:AMD\"));",
              "      pm.test(\"the quote source names its session\", () => {",
              "        pm.expect(body.sources[0].kind).to.eql(\"market\");",
              "        pm.expect(body.sources[0].label).to.include(\"session\");",
              "      });",
              "      pm.test(\"answer cites [Doc N]\", () => pm.expect(body.answer).to.match(/\\[Doc \\d+\\]/));",
              "    },",
              "    \"quick-news\": () => {",
              "      pm.test(\"only the news tool ran\", () => pm.expect(body.used_tools).to.eql([\"news\"]));",
              "      pm.test(\"every source is a headline\", () => body.sources.forEach(s => pm.expect(s.kind).to.eql(\"news\")));",
              "    },",
              "    \"quick-filings\": () => {",
              "      pm.test(\"only the filings search ran\", () => pm.expect(body.used_tools).to.eql([\"rag\"]));",
              "      pm.test(\"sources are filing excerpts\", () => pm.expect(body.sources[0].kind).to.eql(\"document\"));",
              "      pm.test(\"company is INTC\", () => pm.expect(body.companies.map(c => c.ticker)).to.eql([\"INTC\"]));",
              "    },",
              "    \"quick-default\": () => {",
              "      pm.test(\"no keyword -> filings search only\", () => pm.expect(body.used_tools).to.eql([\"rag\"]));",
              "      pm.test(\"company is NVDA\", () => pm.expect(body.companies.map(c => c.ticker)).to.eql([\"NVDA\"]));",
              "    },",
              "    \"quick-all\": () => {",
              "      pm.test(\"market, news and filings all ran\", () => pm.expect(body.used_tools).to.have.members([\"market\", \"news\", \"rag\"]));",
              "      const keys = [\"market:NVDA\", \"market:AMD\", \"news:NVDA\", \"news:AMD\", \"rag\"];",
              "      pm.test(\"one timing per tool call (5)\", () => keys.forEach(k => pm.expect(timings).to.have.property(k)));",
              "      const sum = keys.reduce((a, k) => a + (timings[k] || 0), 0);",
              "      console.log(\"tool seconds summed:\", sum.toFixed(2), \" total - llm:\", (timings.total - timings.llm).toFixed(2));",
              "      pm.test(\"tools ran in parallel (their summed time > the time before the LLM call)\", () =>",
              "        pm.expect(sum).to.be.above(timings.total - timings.llm));",
              "    },",
              "    \"deep-fast\": () => {",
              "      pm.test(\"fast path taken (no planner call)\", () => pm.expect(t.fast_path).to.eql(true));",
              "      pm.test(\"one market task, one round\", () => {",
              "        pm.expect(t.plan.tasks.map(x => x.agent)).to.eql([\"market\"]);",
              "        pm.expect(t.rounds).to.have.lengthOf(1);",
              "      });",
              "      pm.test(\"answer cites evidence [E#]\", () => pm.expect(body.answer).to.match(/\\bE\\d+\\b/));",
              "      pm.test(\"checker ran\", () => pm.expect(t.checker.numbers_checked).to.be.a(\"number\"));",
              "    },",
              "    \"deep-planner\": () => {",
              "      const agents = t.plan.tasks.map(x => x.agent);",
              "      console.log(\"planned agents:\", agents.join(\", \"), \"| rounds:\", t.rounds.length,",
              "                  \"| follow_up_agents:\", (t.follow_up_agents || []).join(\", \") || \"none\");",
              "      t.rounds[0].forEach(r => console.log(\"  round 1\", r.agent, r.seconds + \" s\", \"tools:\", tools(r).join(\", \")));",
              "      console.log(\"checker:\", JSON.stringify(t.checker));",
              "      pm.test(\"planner used (not the fast path)\", () => pm.expect(t.fast_path).to.eql(false));",
              "      pm.test(\"2+ specialists planned\", () => pm.expect(agents.length).to.be.at.least(2));",
              "      pm.test(\"answer cites evidence [E#] and cited sources are marked\", () => {",
              "        pm.expect(body.answer).to.match(/\\bE\\d+\\b/);",
              "        pm.expect(body.sources.some(s => s.cited)).to.eql(true);",
              "      });",
              "      pm.test(\"fact-checker result recorded\", () => pm.expect(t.checker.numbers_checked).to.be.a(\"number\"));",
              "      pm.test(\"unsupported numbers are marked in the answer\", () => {",
              "        if ((t.checker.unsupported || []).length) pm.expect(body.answer).to.include(\"unverified\");",
              "      });",
              "    },",
              "    \"deep-unfiled\": () => {",
              "      const r = t.rounds[0][0];",
              "      console.log(\"filings tools:\", tools(r).join(\", \"), \"| gaps:\", JSON.stringify(r.gaps));",
              "      r.findings.forEach(f => console.log(\"  finding:\", f.claim));",
              "      pm.test(\"fast path to the filings specialist\", () => {",
              "        pm.expect(t.fast_path).to.eql(true);",
              "        pm.expect(t.plan.tasks[0].agent).to.eql(\"filings\");",
              "      });",
              "      pm.test(\"filings specialist reports a gap (expected: Q3 FY2027 not filed yet)\", () =>",
              "        pm.expect(r.gaps).to.be.an(\"array\").that.is.not.empty);",
              "      pm.test(\"and still reports the latest period it found\", () => pm.expect(r.findings).to.not.be.empty);",
              "    },",
              "  };",
              "  if (checks[expect]) checks[expect]();",
              "",
              "  const calls = Number(timings.llm_calls || 0);",
              "  const total = Number(pm.collectionVariables.get(\"gemini_calls\") || 0) + calls;",
              "  pm.collectionVariables.set(\"gemini_calls\", total);",
              "  console.log(expect, \"done:\", timings.total + \" s,\", calls, \"Gemini calls; running total\", total);",
              "  postman.setNextRequest(pm.collectionVariables.get(\"after_poll\") || null);",
              "}"
            ]
          }
        }
      ]
    }
  ],
