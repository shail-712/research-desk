{
  "info": {
    "name": "Research Desk API",
    "description": "Every route in docs/SPEC.md §5. Set the collection variables base_url (the stack's ApiUrl output) and access_code (APP_ACCESS_CODE), then run the collection in order: each Poll request repeats every 3 s until its job is done (up to 40 polls).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health (no access code)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"ok is true\", () => pm.expect(pm.response.json()).to.eql({ok: true}));"
            ]
          }
        }
      ]
    },
