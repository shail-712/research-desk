    {
      "name": "Ask (Quick)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-access-code",
            "value": "{{access_code}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/ask",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ask"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is AMD's market cap and P/E ratio, and what are the latest headlines?\",\n  \"mode\": \"quick\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
              "const job = pm.response.json();",
              "pm.test(\"returns a job id and a poll path\", () => {",
              "  pm.expect(job.job_id).to.match(/^[0-9a-f]{32}$/);",
              "  pm.expect(job.poll).to.eql(\"/ask/\" + job.job_id);",
              "});",
              "pm.collectionVariables.set(\"quick_job\", job.job_id);",
              "pm.collectionVariables.set(\"polls\", 0);"
            ]
          }
        }
      ]
    },
    {
      "name": "Poll Quick answer",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-access-code",
            "value": "{{access_code}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/ask/{{quick_job}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ask",
            "{{quick_job}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const polls = Number(pm.collectionVariables.get(\"polls\") || 0);",
              "if (body.status === \"pending\" && polls < 40) {",
              "  pm.collectionVariables.set(\"polls\", polls + 1);",
              "  setTimeout(() => {}, 3000);",
              "  postman.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.collectionVariables.set(\"polls\", 0);",
              "  pm.test(\"job is done\", () => pm.expect(body.status).to.eql(\"done\"));",
              "  pm.test(\"answer cites sources\", () => {",
              "    pm.expect(body.answer).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(body.sources).to.be.an(\"array\").that.is.not.empty;",
              "  });",
              "  pm.test(\"no context unless include_context\", () => pm.expect(body).to.not.have.property(\"context\"));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Ask (Deep, the brief's query)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-access-code",
            "value": "{{access_code}}"
