    {
      "name": "Add to watchlist (by name)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-access-code",
            "value": "{{access_code}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/watchlist",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "watchlist"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Apple\",\n  \"pct_move\": 2.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"resolved to AAPL\", () => pm.expect(pm.response.json().added.ticker).to.eql(\"AAPL\"));"
            ]
          }
        }
      ]
    },
