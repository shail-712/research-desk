          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ask"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"How did NVIDIA perform in its latest quarter (Q3), and how does that compare with AMD and Intel's growth? What share of NVIDIA's revenue comes from its largest GPU customers, what competitive threats does it face, and what are the current market sentiment and main risks?\",\n  \"mode\": \"deep\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
              "const job = pm.response.json();",
